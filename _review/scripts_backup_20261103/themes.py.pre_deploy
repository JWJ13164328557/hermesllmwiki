# 缩写 `epigenetics-gr` / `single-cell-spatial` 也在用，这里全部收敛。
THEME_TAG_ALIASES = {
    # 单细胞 / 空间
    'single-cell-spatial': 'single-cell-spatial-omics',
    'single-cell-spatial-omics': 'single-cell-spatial-omics',
